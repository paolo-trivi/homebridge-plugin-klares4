{
    "name": "homebridge-plugin-klares4",
    "version": "2.2.0",
    "description": "Plugin completo per sistemi Ksenia Lares4 - Zone, Luci, Tapparelle, Termostati, Sensori",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "prebuild": "node scripts/clean-dist.js",
        "build:release": "npm run build -- --sourceMap false",
        "check:max-lines": "node scripts/check-max-lines.js src 350",
        "check:pack": "node scripts/check-pack.js",
        "verify": "npm run check:max-lines && npx tsc --noEmit --noUnusedLocals --noUnusedParameters && npm test",
        "release:dry-run": "npm publish --tag rc --dry-run",
        "test": "npm run build && node --test --test-timeout=180000 $(find test -name '*.test.js' -print)",
        "test:contract": "npm run build && node --test --test-timeout=180000 test/matter-real-stack-contract.test.js",
        "test:coverage": "npm run build && node --test --test-timeout=180000 --enable-source-maps --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-lines=92 --test-coverage-branches=87 --test-coverage-functions=93 $(find test -name '*.test.js' -print)",
        "prepack": "npm run build:release"
    },
    "keywords": [
        "homebridge-plugin",
        "ksenia",
        "lares4",
        "security",
        "automation",
        "zones",
        "lights",
        "covers",
        "thermostats",
        "sensors",
        "homekit",
        "smart-home",
        "domotica"
    ],
    "engines": {
        "node": ">=22.12.0",
        "homebridge": "^1.6.0 || ^2.0.0-beta.0"
    },
    "dependencies": {
        "mqtt": "^5.3.4",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/ws": "^8.5.0",
        "homebridge": "^2.0.0-beta.0",
        "typescript": "^7.0.2"
    },
    "author": {
        "name": "Paolo Trivisonno",
        "url": "https://github.com/paolo-trivi"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paolo-trivi/homebridge-plugin-klares4.git"
    },
    "bugs": {
        "url": "https://github.com/paolo-trivi/homebridge-plugin-klares4/issues"
    },
    "homepage": "https://github.com/paolo-trivi/homebridge-plugin-klares4#readme",
    "files": [
        "dist",
        "!dist/**/*.map",
        "config.schema.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/paolo-trivi"
    }
}
