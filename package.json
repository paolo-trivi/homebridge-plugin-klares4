{
    "name": "homebridge-plugin-klares4",
    "version": "2.2.0",
    "displayName": "Klares4 - Ksenia Lares4",
    "description": "Homebridge plugin for Ksenia Lares4 alarm systems: zones, lights, covers, thermostats and sensors over HomeKit, Matter and MQTT, local only, no cloud, no telemetry",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "prebuild": "node scripts/clean-dist.js",
        "build:release": "npm run build -- --sourceMap false",
        "check:max-lines": "node scripts/check-max-lines.js src 350",
        "check:pack": "node scripts/check-pack.js",
        "verify": "npm run check:max-lines && npx tsc --noEmit --noUnusedLocals --noUnusedParameters && npm test",
        "release:dry-run": "npm publish --tag rc --dry-run",
        "test": "npm run build && node scripts/run-tests.js",
        "test:real-stack": "npm run build && node scripts/run-tests.js --real-stack-only",
        "test:contract": "npm run build && node --test --test-timeout=60000 test/matter-real-stack-contract.test.js",
        "test:coverage": "npm run build && node --test --test-concurrency=2 --test-timeout=120000 --enable-source-maps --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-lines=92 --test-coverage-branches=87 --test-coverage-functions=93 $(find test -name '*.test.js' -print)",
        "prepack": "npm run build:release"
    },
    "keywords": [
        "homebridge-plugin",
        "homebridge",
        "ksenia",
        "lares4",
        "lares-4",
        "alarm",
        "security",
        "homekit",
        "matter",
        "mqtt",
        "alexa",
        "google-home",
        "thermostat",
        "zones",
        "covers",
        "smart-home",
        "home-automation"
    ],
    "engines": {
        "node": ">=22.12.0",
        "homebridge": "^1.6.0 || ^2.0.0-beta.0"
    },
    "dependencies": {
        "mqtt": "^5.3.4",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/ws": "^8.5.0",
        "homebridge": "^2.0.0-beta.0",
        "typescript": "^7.0.2"
    },
    "author": {
        "name": "Paolo Trivisonno",
        "url": "https://github.com/paolo-trivi"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paolo-trivi/homebridge-plugin-klares4.git"
    },
    "bugs": {
        "url": "https://github.com/paolo-trivi/homebridge-plugin-klares4/issues"
    },
    "homepage": "https://github.com/paolo-trivi/homebridge-plugin-klares4#readme",
    "files": [
        "dist",
        "!dist/**/*.map",
        "config.schema.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/paolo-trivi"
    }
}
